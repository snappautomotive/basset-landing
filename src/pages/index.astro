---
// Landing page. The Nav bar (design/README.md §1) sits outside the centred
// .content column so its white surface and 1px hairline reach the viewport
// edges — the nav's own padding uses --content-padding-x to keep its inner
// edges aligned with the content below it. The Hero (design/README.md §2)
// mounts inside .content and provides its own H1; Promise (design/README.md
// §3) follows in the same column, separated by its own 1px hairline top
// border, Mechanism (design/README.md §4) follows next with the same
// separator rule, Research (design/README.md §5) follows Mechanism with the
// same separator rule, FailureModes (design/README.md §6) follows
// Research with the same separator rule, NotSection (design/README.md
// §7) follows FailureModes with the same separator rule, and CtaPanel
// (design/README.md §8) closes the content column — its tinted card acts
// as the visual break, so unlike the sections above it does not carry a
// hairline top border. The footer arrives in a later bead.
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Promise from "../components/Promise.astro";
import Mechanism from "../components/Mechanism.astro";
import Research from "../components/Research.astro";
import FailureModes from "../components/FailureModes.astro";
import NotSection from "../components/NotSection.astro";
import CtaPanel from "../components/CtaPanel.astro";
---

<BaseLayout>
  <Nav />
  <main class="content">
    <Hero />
    <Promise />
    <Mechanism />
    <Research />
    <FailureModes />
    <NotSection />
    <CtaPanel />
  </main>
</BaseLayout>
