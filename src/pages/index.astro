---
// Landing page placeholder. The full design brief content lands in follow-up
// beads (dox.1 through dox.10); this bead scaffolds Astro and the Pages
// deploy workflow only.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Basset</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
    />
    <style>
      :root {
        --page-ground: #fcfcfc;
        --ink: #1c1e21;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        background: var(--page-ground);
        color: var(--ink);
        font-family: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI",
          sans-serif;
        min-height: 100vh;
      }

      h1 {
        margin: 0;
        padding: 2rem;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <h1>Basset</h1>
  </body>
</html>
