---
/**
 * Nav — the site nav bar.
 *
 * Recreates design/README.md §1 (Nav bar) and the approved reference in
 * design/design-reference/Basset Landing.dc.html exactly: white surface,
 * 1px hairline bottom border, a flex row with the brand and byline on the
 * left and a single contact link pushed to the right. Wraps on narrow
 * viewports so the brand + byline stack above the link without horizontal
 * overflow.
 *
 * The brand is a plain text label per the reference (not a link — there
 * is nowhere to navigate to on a single-page site). The mugo-mark SVG
 * ships from public/mugo-mark.svg (a verbatim copy of
 * design/assets/mugo-mark.svg — the brief forbids recoloring) and is
 * requested as a plain <img> because the nav uses it at a single fixed
 * 18x18 size and the file is tiny.
 *
 * Every color, size, spacing, and copy string here is bound by the brief;
 * QA verifies against design/README.md §1 at 1440x900 and 390x844.
 */
---

<nav class="nav" aria-label="Site">
  <span class="brand">Basset</span>
  <span class="byline">
    by Snapp Automotive ×
    <img
      class="mugo-mark"
      src="/mugo-mark.svg"
      alt=""
      width="18"
      height="18"
    />
    mugo works
  </span>
  <a class="contact" href="mailto:michel@snappautomotive.io">
    Bring us a bug that cost you days. Talk to us.
  </a>
</nav>

<style>
  /* Container — full-bleed white bar with the hairline underline the brief
     specifies. Internal padding uses --content-padding-x so the nav's
     inner edges line up with the .content column below it. flex-wrap
     lets the contact link drop onto its own line at narrow widths without
     horizontal overflow. */
  .nav {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-hairline);
    padding: 16px var(--content-padding-x);
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  /* Brand — "Basset" 19px/700 in ink. Letter-spacing matches the
     approved reference exactly. */
  .brand {
    font-family: var(--font-sans);
    font-size: 19px;
    font-weight: var(--weight-bold);
    letter-spacing: -0.01em;
    color: var(--color-ink);
    line-height: 1;
  }

  /* Byline — mono 12px muted. inline-flex so the inline mugo mark and
     the surrounding text sit on one baseline; the 8px inner gap matches
     the reference. */
  .byline {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted);
  }

  /* mugo mark — 18x18 verbatim asset. The width/height attributes on the
     <img> already reserve the box; this rule pins it explicitly so a
     stray global img rule cannot resize it. */
  .mugo-mark {
    width: 18px;
    height: 18px;
    vertical-align: middle;
  }

  /* Contact link — pushed to the far right of the flex row via
     margin-left: auto. On narrow viewports flex-wrap drops it onto its
     own line and the auto margin collapses; text-decoration is off per
     the brief. */
  .contact {
    margin-left: auto;
    font-family: var(--font-sans);
    font-size: 13.5px;
    font-weight: var(--weight-medium);
    color: var(--color-accent-text);
    text-decoration: none;
  }

  .contact:hover {
    color: var(--color-link-hover);
  }

  .contact:focus-visible {
    outline: 2px solid var(--color-accent-text);
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>
