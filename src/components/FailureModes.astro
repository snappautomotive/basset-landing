---
/**
 * FailureModes — the failure-modes section.
 *
 * Recreates design/README.md §6 (Failure-modes section) and the approved
 * reference in design/design-reference/Basset Landing.dc.html exactly: a
 * left-aligned section with **no kicker** (per the brief), whose sole body
 * is a two-up row pairing a left-column text stack (H2 + muted body) with
 * a right-column crash-trace figure and caption. The section is separated
 * from Research above it by a 1px hairline top border — the global rule
 * the brief specifies for section separation.
 *
 * The crash-trace screenshot (crash-trace.png, 3176x2100) is served through
 * Astro's <Image> so the build emits multiple widths and a modern format
 * via a <picture> with srcset — the brief calls all screenshots out for
 * responsive delivery.
 *
 * The two-up grid uses `minmax(min(320px, 100%), 1fr)` instead of the raw
 * `minmax(320px, 1fr)` the brief cites. The intent (a natural 640-ish
 * breakpoint where the two columns collapse to one) is preserved at every
 * wider width, but the min() lets each track shrink below 320px when the
 * container is narrower than that (e.g. a 320px viewport whose content
 * column is only 280px after --content-padding-x), which prevents the
 * horizontal-scroll overflow the raw form would cause at the narrow end of
 * the range.
 *
 * Source order is text-col first, figure second: at the wide breakpoint the
 * text sits on the left and the figure on the right (align-items: center
 * pairs them vertically); when the row collapses to a single column below
 * ~640px the text stacks above the figure, matching the design-reference.
 *
 * Every color, size, spacing, radius, and copy string here is bound by the
 * brief; values live in src/styles/tokens.css and are read through the token
 * custom properties so a single change ripples across the site. QA verifies
 * against design/README.md §6 at 1440x900 and 390x844, and confirms there
 * is no horizontal scroll at 320/330/340 as well.
 */

import { Image } from "astro:assets";
import crashTrace from "../../design/assets/crash-trace.png";
---

<section class="failure-modes" aria-labelledby="failure-modes-heading">
  <div class="failure-row">
    <div class="text-col">
      <h2 id="failure-modes-heading" class="failure-modes-heading">
        It handles more than one kind of failure.
      </h2>
      <p class="body">
        A permission denial traced across processes, or a hard crash: seed the walk from any log record, including a stack frame.
      </p>
    </div>

    <figure class="crash-figure">
      <div class="crash-frame">
        <Image
          src={crashTrace}
          alt="A crash trace: walk connected to its cause along a real edge-path"
          widths={[320, 640, 800, 1024]}
          sizes="(max-width: 640px) 100vw, 46vw"
          class="crash-image"
        />
      </div>
      <figcaption class="crash-caption">
        A crash trace: the walk connected the failing record to its cause along a real edge-path.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  /* Section container — the brief's global separation rule: a 1px hairline
     top border between sections, with fluid vertical padding. Left-aligned
     block, matching every other section. No kicker on this section per
     the brief. */
  .failure-modes {
    border-top: 1px solid var(--color-hairline);
    padding: var(--section-padding-y) 0;
    text-align: left;
  }

  /* Two-up row — auto-fit + minmax(min(320px, 100%), 1fr) collapses two
     columns to one below ~640px per the brief. The min(320px, 100%)
     idiom lets each track shrink below 320px when the container is
     narrower than that (e.g. a 320px viewport whose content column is
     only 280px after --content-padding-x), which prevents horizontal
     overflow at the narrow end of the range. At every wider width the
     behaviour is unchanged — minmax resolves to minmax(320px, 1fr).
     align-items: center vertically centers the text stack with the
     crash-trace figure at the wider breakpoint; source order (text
     first, figure second) means the figure stacks below the text when
     the row collapses to one column, matching the design-reference. */
  .failure-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
  }

  /* Left column — the text stack. min-width: 0 lets the H2 wrap inside a
     shrinking track instead of forcing the grid track wider than the row,
     which would push the figure off the viewport at narrow widths. */
  .text-col {
    min-width: 0;
  }

  /* Section H2 — the global h2 rule in BaseLayout already applies the type
     tokens (family/size/weight/line-height/letter-spacing); we reset the
     top margin to 0 so the row's vertical centring anchors on the H2's
     first line, and pin ink color defensively so a global tweak cannot
     mute it. */
  .failure-modes-heading {
    margin: 0;
    color: var(--color-ink);
  }

  /* Body paragraph — 16px/26px muted per the brief. The 44ch measure keeps
     the paragraph paired visually with the H2 above it. margin-top uses the
     brief's 18px value from the design-reference. */
  .body {
    margin: 18px 0 0;
    font-family: var(--font-sans);
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    color: var(--color-muted);
    max-width: 44ch;
  }

  /* Crash figure — the outer semantic figure. margin: 0 resets the
     browser's default figure margins so the grid's gap is the sole
     source of separation. min-width: 0 lets the figure shrink inside a
     narrow grid track without forcing overflow. */
  .crash-figure {
    margin: 0;
    min-width: 0;
  }

  /* Crash frame — a flat bordered frame (no shadow, per §6 which lists
     other figures as border-only) at the card radius, holding the
     screenshot. overflow: hidden clips the image to the 12px radius so
     the corners remain crisp. */
  .crash-frame {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-surface);
  }

  /* Crash image — a block image that fills the frame, respecting the
     source aspect ratio (3176/2100). Astro's <Image> emits width/height
     attributes from the imported source, so the aspect ratio is
     preserved without CLS. */
  .crash-image {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Crash caption — 13px/20px muted; sits 14px below the frame per the
     design-reference. */
  .crash-caption {
    margin: 14px 0 0;
    font-family: var(--font-sans);
    font-size: var(--font-size-figure-caption);
    line-height: var(--line-height-figure-caption);
    color: var(--color-muted);
  }
</style>
